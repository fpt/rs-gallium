# Integration-test image. Runs testsuite/runner.sh inside a Linux container on
# any Docker host (Linux, macOS, or Windows via Docker Desktop). Bind-mounts
# the host's HuggingFace cache so model weights are shared with native runs,
# and redirects mktemp (via TMPDIR) to a host-mounted logs directory so per-run
# work dirs / outputs survive the container.
#
# ── Build ──────────────────────────────────────────────────────────────────────
#   docker build -f Dockerfile.integration -t gallium-integration .
#
# ── Run (Linux / macOS) ───────────────────────────────────────────────────────
#   docker run --rm \
#     -v "$HOME/.cache/huggingface:/root/.cache/huggingface" \
#     -v "${TMPDIR:-/tmp}:/logs" \
#     gallium-integration capital gemma4
#
# ── Run (Windows PowerShell) ──────────────────────────────────────────────────
#   docker run --rm `
#     -v "${env:USERPROFILE}\.cache\huggingface:/root/.cache/huggingface" `
#     -v "${env:TEMP}:/logs" `
#     gallium-integration capital gemma4
#
# ── Run full matrix instead of a single case ──────────────────────────────────
#   docker run --rm \
#     -v "$HOME/.cache/huggingface:/root/.cache/huggingface" \
#     -v "${TMPDIR:-/tmp}:/logs" \
#     --entrypoint /app/testsuite/matrix_runner.sh \
#     gallium-integration
#
# The first positional arg to `docker run` is the testcase; the second is the
# backend (see testsuite/backends.txt, resolved to configs/*.toml). Anything
# that runner.sh writes via
# mktemp (work dirs, output.txt, error.txt) lands under /logs on the host.
# Model weights downloaded by hf_hub are read from (and written back to) the
# mounted HuggingFace cache, so repeat runs are fully offline.

# ── Stage 1: build ──────────────────────────────────────────────────────────
# Pinned to a Debian suite, not the floating `rust:1.94-slim`, so the runtime
# stage below can match its glibc. See the note on that stage.
FROM rust:1.94-slim-trixie AS builder

# git: candle (git dep) + llama.cpp vendored source
# pkg-config + libssl-dev: openssl-sys (via hf-hub / native-tls)
# build-essential (g++): esaxx-rs (C++ suffix-array lib, dep of tokenizers)
# cmake + libclang-dev: llama-cpp-sys-2 builds llama.cpp via cmake and its
#   bindings via bindgen, which needs libclang at build time
RUN apt-get update && apt-get install -y --no-install-recommends \
    git pkg-config libssl-dev build-essential cmake libclang-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy manifests first for layer-cached dependency fetch.
COPY Cargo.toml Cargo.lock ./
COPY crates/gallium-core/Cargo.toml   crates/gallium-core/Cargo.toml
COPY crates/gallium-models/Cargo.toml crates/gallium-models/Cargo.toml
COPY crates/gallium-agent/Cargo.toml  crates/gallium-agent/Cargo.toml

# Stub source files so `cargo fetch` succeeds without full source.
RUN mkdir -p crates/gallium-core/src   && echo "pub fn _stub() {}" > crates/gallium-core/src/lib.rs  \
 && mkdir -p crates/gallium-models/src && echo "pub fn _stub() {}" > crates/gallium-models/src/lib.rs \
 && mkdir -p crates/gallium-agent/src  && echo "fn main() {}"      > crates/gallium-agent/src/main.rs

RUN cargo fetch

# Real sources.
COPY crates/ crates/
# target-feature=+avx2,+fma: candle's k-quant vec_dot uses #[cfg(target_feature="avx2")]
# at compile time (unlike gemm-f32 which detects at runtime), so without this flag it
# falls through to vec_dot_unopt even on AVX2 hardware.
RUN RUSTFLAGS="-C target-feature=+avx2,+fma" \
    cargo build --release -p gallium-agent

# ── Stage 2: runtime ────────────────────────────────────────────────────────
# Same Debian release as the builder so the glibc/libstdc++ the binary was
# linked against is the one it finds here. This was `ubuntu:24.04` against a
# trixie builder — glibc 2.39 running a binary linked against 2.41, which does
# not start.
FROM debian:trixie-slim AS runtime

# bash + coreutils: testsuite/*.sh (bash-specific, and mktemp/grep/find)
# golang-go: the `coding` and `refactoring` checks run `go build`
# libssl3t64: native-tls. Named in full rather than as `libssl3`, which trixie
#   carries only as a virtual package that libssl3t64 provides — the 64-bit
#   time_t rename. It resolves today because exactly one package provides it,
#   which is a thinner guarantee than naming the real one. (The top-level
#   Dockerfile is on bookworm, where `libssl3` is the actual package.)
# libgomp1 + libstdc++6: llama.cpp (OpenMP, C++ runtime)
# curl: commonly reached for by the agent's `bash` tool
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates bash coreutils golang-go \
      libssl3t64 libgomp1 libstdc++6 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /build/target/release/gallium /usr/local/bin/gallium
COPY testsuite/ /app/testsuite/

RUN find /app/testsuite -name "*.sh" -exec sed -i 's/\r$//' {} + \
 && chmod +x /app/testsuite/runner.sh /app/testsuite/matrix_runner.sh \
             /app/testsuite/extract_response.sh /app/testsuite/gallium_cli.sh \
 && find /app/testsuite/testcases -name check.sh -exec chmod +x {} +

# Host mounts:
#   /root/.cache/huggingface  ← %USERPROFILE%\.cache\huggingface   (model weights)
#   /logs                     ← %TEMP%                             (runner work dirs + stdout/stderr)
VOLUME /root/.cache/huggingface
VOLUME /logs

# mktemp (used by testsuite/runner.sh) honors TMPDIR, so work dirs land on the
# host-mounted logs volume rather than the ephemeral container fs. GALLIUM_BIN
# points the gallium_cli.sh adapter at the installed binary.
ENV TMPDIR=/logs \
    GALLIUM_BIN=/usr/local/bin/gallium \
    MAX_TOKENS=768

ENTRYPOINT ["/app/testsuite/runner.sh"]
CMD ["capital", "gemma4"]
